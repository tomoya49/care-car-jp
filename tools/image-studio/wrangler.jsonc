// 画像生成ツール（社内用）。LP（リポジトリ直下の wrangler.jsonc）とは別の Worker として公開する。
// 公開URLの予定: https://care-car-image-studio.tooshiro-blog.workers.dev
// 使い方・公開手順は README.md
{
  "$schema": "../../../tooshiro-blog/node_modules/wrangler/config-schema.json",
  "name": "care-car-image-studio",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /api/ だけはプログラム（src/worker.js）が受ける
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Workers AI（無料枠: 1日 10,000 Neurons。日本時間の朝9時に戻る）
  "ai": { "binding": "AI" },
  "vars": {
    // 生成エンジン: "cloudflare"（無料枠）または "openai"（有料・OPENAI_API_KEY が必要）
    "IMAGE_ENGINE": "cloudflare",
    // openai のときに使う画像モデル
    "OPENAI_IMAGE_MODEL": "gpt-image-2"
  }
  // APP_PASSWORD（と openai のときの OPENAI_API_KEY）は秘密の値なので、ここには書かない（README.md 参照）
}
